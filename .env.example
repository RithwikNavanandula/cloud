# Copy to .env in this folder, or set in PythonAnywhere Web → Environment variables
JWT_SECRET=change-me-to-a-long-random-string
EDGE_SYNC_SECRET=change-me-shared-with-windows-server
SEED_SAMPLE_DATA=1

# Optional: lets the cloud UI proxy live detection/camera commands to edge.
# Local test: http://127.0.0.1:5001
# LAN/tunnel: http://YOUR_EDGE_IP:5000 or https://your-tunnel-url
EDGE_API_URL=

# Defaults (usually leave alone):
# FRONTEND_DIST=/home/YOUR_USERNAME/cloud/static
# DB_PATH=/home/YOUR_USERNAME/cloud/aicctv.db
# UPLOAD_DIR=/home/YOUR_USERNAME/cloud/uploads
